.xn-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  height: 50px;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
  background: #ffffff;
  border-top: 1rpx solid #e5e7eb;
}

.xn-tabbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.xn-tabbar__icon {
  width: 24px;
  height: 24px;
  margin-bottom: 4rpx;
}

.xn-tabbar__text {
  font-size: 20rpx;
  line-height: 1;
  color: #9ca3af;
}

.xn-tabbar__text.is-active {
  color: #0f766e;
  font-weight: 600;
}
