{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/home/index",
      "style": {
        "navigationBarTitleText": "首页"
      }
    },
    {
      "path": "pages/order/list",
      "style": {
        "navigationBarTitleText": "工单",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/auth/login",
      "style": {
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pages/auth/profile",
      "style": {
        "navigationBarTitleText": "完善资料"
      }
    },
    {
      "path": "pages/auth/agreement",
      "style": {
        "navigationBarTitleText": "协议"
      }
    },
    {
      "path": "pages/order/edit",
      "style": {
        "navigationBarTitleText": "编辑报修"
      }
    },
    {
      "path": "pages/order/detail",
      "style": {
        "navigationBarTitleText": "报修详情"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/enterprise/join",
      "style": {
        "navigationBarTitleText": "加入企业"
      }
    },
    {
      "path": "pages/admin/enterprise/list",
      "style": {
        "navigationBarTitleText": "企业管理",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/admin/enterprise/detail",
      "style": {
        "navigationBarTitleText": "企业详情",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/admin/order/detail",
      "style": {
        "navigationBarTitleText": "工单处理"
      }
    },
    {
      "path": "pages/stats/index",
      "style": {
        "navigationBarTitleText": "数据统计",
        "enablePullDownRefresh": true
      }
    }
  ],
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#0f766e",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "custom": true,
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/stats/index",
        "text": "统计",
        "iconPath": "static/tabbar/stats.png",
        "selectedIconPath": "static/tabbar/stats-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "static/tabbar/profile.png",
        "selectedIconPath": "static/tabbar/profile-active.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "新泥报修",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F4F6F8"
  },
  "uniIdRouter": {}
}
