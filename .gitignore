# =============================================================================
# 新泥报修系统 — 根级 .gitignore
# 覆盖 backend / web-frontend / uni-app-frontend 三个子项目
# =============================================================================

# ── Go 后端构建产物 ──
*.exe
*.exe~
*.dll
*.so
*.dylib
backend/cmd/server/__debug_bin*
backend/build/

# ── 日志 ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── 依赖与构建输出 ──
node_modules/
dist/
dist-ssr/
unpackage/

# ── 敏感配置（含密钥/密码，通过环境变量注入） ──
backend/config/config.yaml
.env
.env.*
!.env.example

# ── 编辑器/IDE ──
.vscode/*
!.vscode/extensions.json
.idea/
.hbuilderx/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── 操作系统 ──
.DS_Store
Thumbs.db
