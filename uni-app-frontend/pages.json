    {
      "path": "pages/admin/enterprise/list",
      "style": {
        "navigationBarTitleText": "企业管理",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/admin/enterprise/create",
      "style": {
        "navigationBarTitleText": "创建企业"
      }
    },
    {
      "path": "pages/admin/enterprise/detail",
      "style": {
        "navigationBarTitleText": "企业详情",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/admin/order/list",
      "style": {
        "navigationBarTitleText": "工单管理",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/admin/order/detail",
      "style": {
        "navigationBarTitleText": "工单处理"
      }
    }
