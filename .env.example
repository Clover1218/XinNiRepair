# [数据库配置]
DB_USER=your_user
DB_PASSWORD=your_strong_password
DB_NAME=repair_db
# 启动时自动执行 GORM AutoMigrate:
#   true  = 首次部署 / 全新库时建议打开, 自动建表加索引 (仅加列加表, 不会删列)
#   false = 有正式数据时保持关闭, 改用 migrations/*.sql 脚本手动迁移
DB_AUTO_MIGRATE=true

# [后端配置] 
EASYIMAGE_ENDPOINT=
EASYIMAGE_TOKEN=
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# [端口映射配置]
# 格式：主机IP:主机端口  （IP 不写则默认使用下面的 IP）
# 注意：默认绑定到 127.0.0.1 仅允许本机访问，若需外部访问请改为 0.0.0.0

# [端口映射配置.PostgreSQL]
POSTGRES_EXPOSE_HOST=127.0.0.1
POSTGRES_EXPOSE_PORT=5432

# [端口映射配置.EasyImage]
EASYIMAGE_EXPOSE_HOST=127.0.0.1
EASYIMAGE_EXPOSE_PORT=7999

# [端口映射配置.WEB前端]
# ⚠️ 前端端口是所有客户端的**唯一入口**：
#   - PC 管理后台：访问 http(s)://主机:FRONTEND_EXPOSE_PORT
#   - uni-app 小程序 BASE_URL 也应指向：http(s)://主机:FRONTEND_EXPOSE_PORT/api/v1
#   后端 / Postgres / EasyImage 全部 Docker 内网可达，不单独暴露。
FRONTEND_EXPOSE_HOST=0.0.0.0
FRONTEND_EXPOSE_PORT=80