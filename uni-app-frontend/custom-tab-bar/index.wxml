<view class="xn-tabbar">
  <view
    class="xn-tabbar__item"
    wx:for="{{renderList}}"
    wx:key="pagePath"
    data-path="{{item.pagePath}}"
    bindtap="switchTab"
  >
    <image
      class="xn-tabbar__icon"
      src="{{item.on ? item.selectedIconPath : item.iconPath}}"
      mode="aspectFit"
    />
    <text class="xn-tabbar__text {{item.on ? 'is-active' : ''}}">{{item.text}}</text>
  </view>
</view>
