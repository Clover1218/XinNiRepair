# [数据库配置]
DB_USER=your_user
DB_PASSWORD=your_strong_password
DB_NAME=repair_db

# [后端配置] 
EASYIMAGE_ENDPOINT=
EASYIMAGE_TOKEN=
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# [端口映射配置]
# 格式：主机IP:主机端口  （IP 不写则默认使用下面的 IP）
# 注意：默认绑定到 127.0.0.1 仅允许本机访问，若需外部访问请改为 0.0.0.0

# [端口映射配置.PostgreSQL]
POSTGRES_EXPOSE_HOST=127.0.0.1
POSTGRES_EXPOSE_PORT=5432

# [端口映射配置.EasyImage]
EASYIMAGE_EXPOSE_HOST=127.0.0.1
EASYIMAGE_EXPOSE_PORT=7999

# [端口映射配置.WEB前端]
FRONTEND_EXPOSE_HOST=0.0.0.0
FRONTEND_EXPOSE_PORT=80